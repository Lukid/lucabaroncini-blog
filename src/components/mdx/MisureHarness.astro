---
// Le tredici misure su harness e modello, dentro l'articolo harness-o-modello. Dati al 2026-11-04.


// Dati: solo punteggi in scala 0-100 (percentuale di task riusciti o punteggio), così l'asse è uno solo.
// Ogni riga: risultato peggiore e migliore fra le configurazioni provate dalla fonte.
type Lever = "harness" | "modello";
interface Row {
  lever: Lever;
  label: string;
  how: string;
  fixed: string;
  from: number;
  to: number;
  task: string;
  caveat: string;
  source: string;
  url: string;
  asOf: string;
}

const rows: Row[] = [
  { lever: "harness", label: "Cambio solo il modo in cui l'agente modifica i file", how: "Di solito l'agente, per modificare un file, deve ricopiare alla lettera il testo da sostituire. Se sbaglia anche un carattere la modifica fallisce, e i modelli piccoli sbagliano spesso. Qui invece indica le righe con un'etichetta corta che lo strumento gli dà quando legge il file.", fixed: "stesso modello: Grok Code Fast", from: 6.7, to: 68.3, task: "modifiche al codice andate a buon fine", caveat: "L'ha misurato l'autore dello strumento e nessuno l'ha ancora rifatto. Su un altro modello lo stesso trucco rende meno.", source: "oh-my-pi", url: "https://github.com/can1357/oh-my-pi", asOf: "agosto 2026" },
  { lever: "harness", label: "Provo dieci agenti di coding diversi", how: "Lo stesso modello montato in dieci agenti di coding, da quelli che danno solo un terminale a quelli con molti strumenti. Il secondo classificato è uno dei più semplici, quasi solo terminale.", fixed: "stesso modello open: DeepSeek V4 Flash", from: 2.7, to: 54.9, task: "113 task di programmazione risolti", caveat: "Una prova sola, fatta da chi vende uno dei dieci agenti.", source: "CodeAF", url: "https://github.com/Agent-Field/CodeAF", asOf: "ottobre 2026" },
  { lever: "harness", label: "Cambio il sistema di memoria, con un modello piccolo", how: "Tre sistemi diversi con cui l'agente si salva e poi ritrova le informazioni di una conversazione lunga.", fixed: "stesso modello: GPT-4o-mini", from: 28, to: 63, task: "risposte giuste a domande che richiedono di ricordare cose dette prima", caveat: "Una prova per combinazione. I sistemi peggiori spesso falliscono perché non aprono nemmeno il file giusto.", source: "MemoryTax", url: "https://arxiv.org/abs/2610.29823", asOf: "ottobre 2026" },
  { lever: "harness", label: "Lascio che l'agente migliori da solo il proprio harness", how: "L'agente propone modifiche alle proprie istruzioni, strumenti e controlli, le prova sui task e tiene quelle che migliorano sia il funzionamento sia la sicurezza del codice.", fixed: "stesso modello", from: 46.7, to: 76.7, task: "codice che funziona ed è sicuro", caveat: "Solo 30 task, un campione piccolo.", source: "Harmony", url: "https://arxiv.org/abs/2610.15150", asOf: "ottobre 2026" },
  { lever: "harness", label: "Do all'agente strumenti e un ritorno sugli errori", how: "Stesso modello, ma con strumenti diversi, più contesto sul problema e la possibilità di vedere l'esito dei test e correggersi.", fixed: "stesso modello: GLM-5.1", from: 52.5, to: 65.5, task: "bug reali risolti, su 100", caveat: "Il numero viene da un report di sintesi, non da uno studio fatto apposta.", source: "State of AI 2026", url: "https://www.stateof.ai/2026-explore/", asOf: "ottobre 2026" },
  { lever: "harness", label: "Separo chi esegue da chi controlla", how: "Un agente fa il lavoro sul desktop scrivendo piccoli programmi che lo comandano. Un secondo agente controlla se il risultato è giusto e, se non lo è, lo rimanda indietro.", fixed: "stesso modello: Kimi-K3", from: 58.3, to: 72.0, task: "lavori completati al computer, su un desktop vero", caveat: "Il confronto con gli altri sistemi non usa le stesse regole né lo stesso budget.", source: "RSIAgent", url: "https://aetherlabsai.github.io/RSIAgent/", asOf: "settembre 2026" },
  { lever: "harness", label: "Faccio riscrivere l'harness a un modello più forte", how: "Un modello più forte guarda come lavora l'agente e gli riscrive istruzioni, regole, memoria, strumenti e skill: otto file in tutto. Il modello che esegue il lavoro resta lo stesso.", fixed: "stesso modello esecutore: GLM-5", from: 64.2, to: 75.7, task: "punteggio massimo su compiti di lavoro d'ufficio", caveat: "Chi riscrive è più forte di chi esegue, e consuma fra 10 e 100 milioni di token per task. Parte dei voti li dà un altro modello.", source: "Harness²", url: "https://arxiv.org/abs/2610.14224", asOf: "ottobre 2026" },
  { lever: "harness", label: "Cambio il sistema di memoria, con un modello forte", how: "Gli stessi tre sistemi di memoria della riga sopra, ma con un modello di frontiera.", fixed: "stesso modello: Opus 5.5", from: 97, to: 99, task: "risposte giuste a domande che richiedono di ricordare cose dette prima", caveat: "Una prova per combinazione. La qualità resta quasi uguale, il costo va da 7 a 28 dollari.", source: "MemoryTax", url: "https://arxiv.org/abs/2610.29823", asOf: "ottobre 2026" },
  { lever: "harness", label: "Provo Claude Code, Codex e Pi", how: "Tre agenti di coding noti, stesso modello. Claude Code parte con un contesto dieci volte più grande di Pi, che ha solo quattro strumenti: leggere, scrivere, modificare, terminale.", fixed: "stesso modello: Fable 5", from: 96.7, to: 97.8, task: "60 task di programmazione e da terminale risolti", caveat: "Le differenze di qualità stanno quasi tutte dentro il margine d'errore. Quelle di costo no.", source: "HarnessTax", url: "https://harnesstax.github.io/", asOf: "ottobre 2026" },
  { lever: "modello", label: "Sei modelli nello stesso harness, compito difficile", how: "Sei modelli nello stesso sistema, che lascia al modello decidere quali parti del documento rileggere scrivendo piccoli programmi. I testi sono lunghi circa 256mila token, un libro intero.", fixed: "stesso harness", from: 22.7, to: 86.7, task: "compiti risolti ragionando su documenti lunghissimi", caveat: "I modelli deboli non sbagliano il formato: non riescono a mettere insieme i passaggi.", source: "Scroll", url: "https://arxiv.org/abs/2608.21690", asOf: "agosto 2026" },
  { lever: "modello", label: "Quattro modelli open nella stessa configurazione", how: "Quattro modelli open nello stesso agente di coding, con la stessa configurazione e la stessa memoria di lavoro.", fixed: "stesso harness", from: 25.2, to: 65.8, task: "bug reali risolti", caveat: "Solo modelli aperti.", source: "Fan et al.", url: "https://arxiv.org/abs/2609.20804", asOf: "ottobre 2026" },
  { lever: "modello", label: "Tengo l'harness e cambio modello", how: "Il migliore dei dieci agenti della riga sopra. Stavolta resta fisso l'agente e cambia il modello.", fixed: "stesso harness: CodeAF", from: 54.9, to: 77.9, task: "113 task di programmazione risolti", caveat: "È la stessa fonte della riga da 52 punti: lì cambiava l'harness, qui il modello.", source: "CodeAF", url: "https://github.com/Agent-Field/CodeAF", asOf: "ottobre 2026" },
  { lever: "modello", label: "Sei modelli nello stesso harness, compito facile", how: "Lo stesso sistema della riga sui documenti lunghi, ma il compito è ritrovare dettagli in conversazioni passate.", fixed: "stesso harness", from: 88.8, to: 94.8, task: "risposte giuste su dettagli di conversazioni lunghe", caveat: "Stesse condizioni della riga sui documenti lunghi. Qui il compito è facile e i modelli quasi si equivalgono.", source: "Scroll", url: "https://arxiv.org/abs/2608.21690", asOf: "agosto 2026" },
];

const fmt = (n: number) => n.toLocaleString("it-IT", { maximumFractionDigits: 1 });
const gain = (r: Row) => r.to - r.from;
---

<style>
  /* Colore = leva cambiata. Chiaro: blu e rosso su carta. Scuro: ocra e verde su blu. Tutti sopra 3:1. */
  .dv { --h: var(--color-blu); --m: var(--color-rosso); }
  :global(.dark) .dv { --h: var(--color-ocra); --m: var(--color-verde); }
  .row[data-lever="harness"], .lever-h { --c: var(--h); }
  .row[data-lever="modello"], .lever-m { --c: var(--m); }
  .track { position: relative; height: 22px; }
  .track .rule { position: absolute; inset: 50% 0 auto 0; border-top: 1px solid var(--color-border); }
  .track .span { position: absolute; top: calc(50% - 2px); height: 4px; background: var(--c); }
  .track .dot { position: absolute; top: 50%; width: 12px; height: 12px; border-radius: 50%; transform: translate(-50%, -50%); background: var(--c); }
  .track .dot.from { background: var(--color-bg); border: 2px solid var(--c); }
  .key { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: var(--c); border: 2px solid currentColor; vertical-align: -1px; }
  .row summary { list-style: none; cursor: pointer; }
  .row summary::-webkit-details-marker { display: none; }
  .row summary:hover .lbl, .row[open] .lbl { color: var(--color-accent); }
  .filters button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }
  .grid-row { display: grid; grid-template-columns: minmax(0, 18rem) minmax(0, 1fr) 4rem; gap: 0.75rem; align-items: center; }
  @media (max-width: 640px) { .grid-row { grid-template-columns: minmax(0, 1fr) 3.5rem; } .grid-row .track { grid-column: 1 / -1; grid-row: 2; } }
</style>

  <section aria-label="Le tredici misure" class="dv not-prose mt-6">
    <p class="max-w-[65ch] text-text-secondary">
      In ogni riga qualcuno ha tenuto ferma una cosa e cambiato l'altra. Il cerchio vuoto è il
      risultato peggiore, quello pieno il migliore. Apri una riga per sapere cosa è stato
      cambiato, il risultato, i limiti della prova e la fonte.
    </p>

    <div class="filters mt-6 flex flex-wrap items-center gap-2 text-sm font-bold" role="group" aria-label="Filtra le misure">
      <button type="button" data-filter="all" aria-pressed="true" class="min-h-11 border-2 border-text px-3">Tutte</button>
      <button type="button" data-filter="harness" aria-pressed="false" class="lever-h min-h-11 border-2 border-text px-3">
        <span class="key"></span> Stesso modello, cambio l'harness
      </button>
      <button type="button" data-filter="modello" aria-pressed="false" class="lever-m min-h-11 border-2 border-text px-3">
        <span class="key"></span> Stesso harness, cambio il modello
      </button>
    </div>

    <div class="grid-row mt-8 text-xs font-bold text-text-secondary" aria-hidden="true">
      <span class="max-sm:hidden"></span>
      <div class="relative h-4 max-sm:hidden">
        {[0, 25, 50, 75, 100].map((t) => (
          <span class="absolute -translate-x-1/2" style={`left:${t}%`}>{t}</span>
        ))}
      </div>
      <span class="text-right tracking-[0.12em] uppercase max-sm:col-start-2">punti</span>
    </div>

    <div id="rows" class="mt-1 border-t border-border">
      {rows.map((r) => (
        <details class="row border-b border-border py-3" data-lever={r.lever}>
          <summary class="grid-row text-base">
            <span class="lbl leading-snug font-semibold">
              {r.label}
              <span class="block text-sm font-normal text-text-secondary">{r.fixed}</span>
            </span>
            <span class="track" role="img" aria-label={`da ${fmt(r.from)} a ${fmt(r.to)}`}>
              <span class="rule"></span>
              <span class="span" style={`left:${r.from}%; width:${gain(r)}%`}></span>
              <span class="dot from" style={`left:${r.from}%`}></span>
              <span class="dot" style={`left:${r.to}%`}></span>
            </span>
            <span class="text-right text-lg font-extrabold">+{fmt(gain(r))}</span>
          </summary>
          <div class="mt-3 mb-2 max-w-[65ch] space-y-2 text-base">
            <p>{r.how}</p>
            <p><strong>Risultato:</strong> da {fmt(r.from)}% a {fmt(r.to)}% di {r.task}.</p>
            <p class="text-text-secondary"><strong>Limiti:</strong> {r.caveat}</p>
            <p class="text-sm">
              <a href={r.url} target="_blank" rel="noopener noreferrer" class="font-semibold underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">{r.source}</a>
              <span class="text-text-secondary"> · {r.asOf}</span>
            </p>
          </div>
        </details>
      ))}
    </div>
  </section>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll(".filters button");
    var rows = document.querySelectorAll("#rows .row");
    buttons.forEach(function (b) {
      b.addEventListener("click", function () {
        var f = b.dataset.filter;
        buttons.forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
        rows.forEach(function (r) { r.hidden = f !== "all" && r.dataset.lever !== f; });
      });
    });
  })();
</script>
