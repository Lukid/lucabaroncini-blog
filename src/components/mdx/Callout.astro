---
interface Props {
  type?: "info" | "warning" | "tip" | "danger" | "note";
}

const { type = "info" } = Astro.props;

const labels = {
  info: "Nota",
  note: "Nota",
  tip: "Consiglio",
  warning: "Attenzione",
  danger: "Pericolo",
} as const;
---

<aside class="my-8 border-2 border-text px-5 py-4 text-base [&_p]:my-0 [&_p+p]:mt-3" role="note">
  <strong class="mb-1 block text-[0.8125rem] font-bold tracking-[0.12em] uppercase">{labels[type]}</strong>
  <slot />
</aside>
