---
import ThemeToggle from "./ThemeToggle.astro";
import { NAV_ITEMS, SITE } from "@/lib/constants";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}

// Il nome porta già alla home.
const items = NAV_ITEMS.filter((item) => item.href !== "/");
---

<header class="border-b border-border">
  <nav
    aria-label="Principale"
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 text-[0.8125rem] font-bold uppercase tracking-[0.12em] sm:px-8"
  >
    <a href="/" class="py-2 font-extrabold" aria-current={currentPath === "/" ? "page" : undefined}>
      {SITE.author}
    </a>

    {/* Desktop */}
    <div class="hidden items-center gap-6 sm:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="border-b-[3px] border-transparent py-1.5 transition-colors hover:text-accent aria-[current=page]:border-accent"
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>

    {/* Mobile */}
    <div class="flex items-center gap-1 sm:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="min-h-11 px-2 font-bold uppercase tracking-[0.12em]"
      >
        Menu
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-border sm:hidden">
    <ul class="mx-auto max-w-5xl px-4 py-2">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="block py-3 text-2xl font-extrabold tracking-[-0.01em] aria-[current=page]:text-accent aria-[current=page]:underline aria-[current=page]:decoration-[3px] aria-[current=page]:underline-offset-8"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");

    function closeMenu() {
      toggle?.setAttribute("aria-expanded", "false");
      if (toggle) toggle.textContent = "Menu";
      menu?.classList.add("hidden");
    }

    toggle?.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      toggle.textContent = expanded ? "Menu" : "Chiudi";
      menu?.classList.toggle("hidden");
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
        closeMenu();
        toggle.focus();
      }
    });
  }
  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
