---
import type { Tag } from "@/lib/constants";
import { formatData } from "@/lib/format";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags: Tag[];
  slug: string;
}

const { title, description, pubDate, tags, slug } = Astro.props;
---

<article class="group relative grid gap-x-8 gap-y-1 border-b border-border py-6 sm:grid-cols-[7rem_minmax(0,1fr)]">
  <time datetime={pubDate.toISOString()} class="text-sm font-semibold text-text-secondary sm:pt-1.5">
    {formatData(pubDate)}
  </time>
  <div class="max-w-[60ch]">
    <h2 class="text-2xl leading-tight font-extrabold tracking-[-0.02em] text-balance sm:text-[1.75rem]">
      <a href={`/blog/${slug}`} class="transition-colors group-hover:text-accent after:absolute after:inset-0">
        {title}
      </a>
    </h2>
    {description && <p class="mt-2 text-text-secondary">{description}</p>}
    {
      tags.length > 0 && (
        <p class="mt-3 text-xs font-bold tracking-[0.12em] text-text-secondary uppercase">
          <span class="sr-only">Tag: </span>
          {tags.join(" · ")}
        </p>
      )
    }
  </div>
</article>
