---
interface Props {
  prevUrl: string | undefined;
  nextUrl: string | undefined;
  currentPage: number;
  lastPage: number;
}

const { prevUrl, nextUrl, currentPage, lastPage } = Astro.props;
---

{
  lastPage > 1 && (
    <nav aria-label="Navigazione pagine" class="mt-12 flex items-center justify-center gap-4">
      {prevUrl ? (
        <a
          href={prevUrl}
          class="inline-flex min-h-11 items-center border-2 border-text px-4 text-[0.8125rem] font-bold tracking-[0.12em] uppercase transition-colors hover:text-accent"
        >
          Precedente
        </a>
      ) : (
        <span class="inline-flex min-h-11 items-center px-4 text-[0.8125rem] font-bold tracking-[0.12em] uppercase text-text-secondary" aria-disabled="true">
          Precedente
        </span>
      )}

      <span class="text-lg font-extrabold" aria-current="page">
        {currentPage} / {lastPage}
      </span>

      {nextUrl ? (
        <a
          href={nextUrl}
          class="inline-flex min-h-11 items-center border-2 border-text px-4 text-[0.8125rem] font-bold tracking-[0.12em] uppercase transition-colors hover:text-accent"
        >
          Successiva
        </a>
      ) : (
        <span class="inline-flex min-h-11 items-center px-4 text-[0.8125rem] font-bold tracking-[0.12em] uppercase text-text-secondary" aria-disabled="true">
          Successiva
        </span>
      )}
    </nav>
  )
}
