---
import BaseLayout from "./BaseLayout.astro";
import CopyButton from "@/components/CopyButton.astro";
import { formatData } from "@/lib/format";
import { SITE, type Tag } from "@/lib/constants";
import Campo from "@/components/Campo.astro";
import { coloreDi, type Colore, type Schermata } from "@/lib/reel";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  tags: Tag[];
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
  readingTime?: number;
  image?: string;
  reel?: Schermata[];
}

const {
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  prevPost,
  nextPost,
  readingTime,
  image,
  reel,
} = Astro.props;

// La fascia prende il colore e la cifra della schermata che porta il numero, come la copertina.
// Senza reel solo forme, sul rosso: il blu sparirebbe sul fondo scuro.
const i = reel?.findIndex((s) => s.cifra) ?? -1;
const fondo: Colore = i >= 0 ? coloreDi(reel![i], i) : "rosso";
const cifra = i >= 0 ? reel![i].cifra : undefined;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Idee", item: `${SITE.url}/blog` },
    { "@type": "ListItem", position: 3, name: title, item: `${SITE.url}/blog/${slug}` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={image}
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={`/blog/${slug}.md`} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>
  <Campo slot="campo" fondo={fondo} seme={slug} cifra={cifra}>
    <h1 class="max-w-4xl text-[2.5rem] leading-[1.02] font-black tracking-[-0.035em] text-balance sm:text-6xl lg:text-[4.5rem]">
      {title}
    </h1>

    <p class="mt-6 max-w-[60ch] text-xl leading-snug sm:text-2xl">
      {description}
    </p>

    <p class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.8125rem] font-bold tracking-[0.12em] uppercase">
      <time datetime={pubDate.toISOString()}>{formatData(pubDate, true)}</time>
      {
        updatedDate && (
          <span>
            aggiornato il <time datetime={updatedDate.toISOString()}>{formatData(updatedDate, true)}</time>
          </span>
        )
      }
      {readingTime && <span>{readingTime} min di lettura</span>}
      {
        tags.map((tag) => (
          <a href={`/tags/${tag}`} class="underline decoration-2 underline-offset-4 hover:decoration-4">
            {tag}
          </a>
        ))
      }
    </p>
  </Campo>
  <article>

    {
      heroImage && (
        <img
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          class="mb-12 w-full"
          loading="eager"
          decoding="async"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    <CopyButton />

    {
      (prevPost || nextPost) && (
        <nav aria-label="Altri articoli" class="mt-16 grid gap-8 border-t border-border pt-8 sm:grid-cols-2">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="group">
              <span class="text-[0.8125rem] font-bold tracking-[0.12em] text-text-secondary uppercase">
                Articolo precedente
              </span>
              <span class="mt-2 block text-xl leading-tight font-extrabold text-balance group-hover:text-accent">
                {prevPost.title}
              </span>
            </a>
          ) : (
            <div class="max-sm:hidden" />
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.slug}`} class="group sm:text-right">
              <span class="text-[0.8125rem] font-bold tracking-[0.12em] text-text-secondary uppercase">
                Articolo successivo
              </span>
              <span class="mt-2 block text-xl leading-tight font-extrabold text-balance group-hover:text-accent">
                {nextPost.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
