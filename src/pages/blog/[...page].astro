---
import { pubblicato, ordinaPerData } from "@/lib/posts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/lib/constants";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = ordinaPerData(await getCollection("blog", ({ data }) => pubblicato(data)));
  return paginate(posts, { pageSize: SITE.postsPerPage });
}

const { page } = Astro.props;

// Tag presenti nei post (tutti, non solo quelli della pagina corrente)
const allPosts = await getCollection("blog", ({ data }) => pubblicato(data));
const tagSet = new Set<string>();
for (const p of allPosts) p.data.tags.forEach((t) => tagSet.add(t));
const availableTags = Array.from(tagSet).sort();

const totalCount = allPosts.length;
---

<BaseLayout title="Idee" description="Tutte le idee di Luca Baroncini su AI applicata, agenti e RAG.">
  <header>
    <h1 class="text-5xl leading-none font-black tracking-[-0.035em] sm:text-7xl">Idee</h1>
    <p class="mt-4 text-lg text-text-secondary">
      {totalCount} {totalCount === 1 ? "idea" : "idee"}, dalla più recente.
    </p>
  </header>

  {
    availableTags.length > 1 && (
      <div class="mt-10 flex flex-wrap items-center gap-2" role="group" aria-label="Filtra per tag" data-filter-bar>
        <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">Tutti</button>
        {availableTags.map((tag) => (
          <button type="button" data-filter={tag} aria-pressed="false" class="filter-chip">
            {tag}
          </button>
        ))}
      </div>
    )
  }

  <div class="mt-6 border-t border-border" data-post-list>
    {
      page.data.map((post: any) => (
        <div data-tags={post.data.tags.join(",")}>
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.id}
          />
        </div>
      ))
    }
  </div>

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
  />
</BaseLayout>

<style>
  .filter-chip {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--color-text);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }
  .filter-chip:hover {
    color: var(--color-accent);
  }
  .filter-chip[aria-pressed="true"] {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
</style>

<script>
  function setupFilters() {
    const bar = document.querySelector<HTMLElement>("[data-filter-bar]");
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    if (!bar || !list) return;

    const chips = bar.querySelectorAll<HTMLButtonElement>(".filter-chip");
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const filter = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        list.querySelectorAll<HTMLElement>("[data-tags]").forEach((item) => {
          const tags = (item.dataset.tags || "").split(",");
          item.hidden = filter !== "all" && !tags.includes(filter ?? "");
        });
      });
    });
  }
  setupFilters();
  document.addEventListener("astro:after-swap", setupFilters);
</script>
