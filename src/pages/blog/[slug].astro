---
import { pubblicato, ordinaPerData } from "@/lib/posts";
import BlogPost from "@/layouts/BlogPost.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = ordinaPerData(await getCollection("blog", ({ data }) => pubblicato(data)));

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[index + 1]
        ? { slug: posts[index + 1].id, title: posts[index + 1].data.title }
        : undefined,
      nextPost: posts[index - 1]
        ? { slug: posts[index - 1].id, title: posts[index - 1].data.title }
        : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  slug={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  heroImage={post.data.heroImage}
  tags={post.data.tags}
  image={`/blog/${post.id}/og.png`}
  prevPost={prevPost}
  nextPost={nextPost}
  reel={post.data.reel}
>
  <Content />
</BlogPost>
