---
import { getCollection } from "astro:content";
import FeedLayout from "@/layouts/FeedLayout.astro";
import Intro from "@/components/feed/Intro.astro";
import Schermata from "@/components/feed/Schermata.astro";
import { pubblicato, ordinaPerData } from "@/lib/posts";

const idee = ordinaPerData(await getCollection("blog", ({ data }) => pubblicato(data) && Boolean(data.reel)));
---

<FeedLayout image={idee[0] ? `/blog/${idee[0].id}/og.png` : undefined}>
  <Intro primaIdea={idee[0]?.id} />
  {
    idee.map((post, i) => {
      const reel = post.data.reel!;
      const prossima = idee[i + 1]
        ? { href: `#${idee[i + 1].id}`, label: "Prossima idea" }
        : { href: "/blog", label: "Tutte le idee" };
      return (
        <article class="md:grid md:grid-cols-[1fr_minmax(0,480px)_1fr] lg:grid-cols-[minmax(15rem,22rem)_minmax(0,1fr)]">
          <div class="md:sticky md:top-0 md:flex md:h-svh md:flex-col md:justify-end md:self-start md:p-10">
            <h2 class="sr-only md:not-sr-only md:max-w-[22ch] md:text-[1.75rem] md:leading-[1.15] md:font-extrabold md:tracking-[-0.02em] md:text-balance">
              {post.data.title}
            </h2>
            <a
              href={`/blog/${post.id}`}
              class="hidden min-h-11 items-center self-start text-[0.8125rem] font-bold tracking-[0.12em] uppercase underline-offset-4 hover:underline md:mt-4 md:inline-flex"
            >
              Leggi l'articolo
            </a>
          </div>
          <div>
            {reel.map((s, j) => (
              <Schermata schermata={s} indice={j + 1} totale={reel.length} slug={post.id} titolo={post.data.title} prossima={prossima} />
            ))}
          </div>
        </article>
      );
    })
  }
</FeedLayout>
