---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import lucaPhoto from "@/assets/luca-baroncini.jpg";
import Campo from "@/components/Campo.astro";
import { PERSON } from "@/lib/constants";

const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: { ...PERSON, image: new URL(lucaPhoto.src, Astro.site).toString() },
};
---

<BaseLayout
  title="Chi sono"
  description="Luca Baroncini porta agenti e sistemi RAG dal prototipo all'esercizio, con un occhio alle prove."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />
  <Campo slot="campo" fondo="verde" seme="chi-sono">
    <h1 class="text-5xl leading-none font-black tracking-[-0.035em] sm:text-7xl">Chi sono</h1>
  </Campo>

  <div class="grid gap-8 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-12">
    <Image
      src={lucaPhoto}
      alt="Luca Baroncini"
      width={320}
      height={320}
      class="aspect-square w-32 object-cover object-top sm:w-40"
    />

    <div class="prose">
      <p>
        Sono Luca Baroncini, Chief AI Officer in
        <a href="https://www.netseven.it" target="_blank" rel="noopener noreferrer">Net7</a>,
        software house di Pisa. Lavoro su agenti e sistemi RAG in produzione, anche per la
        pubblica amministrazione, e guido team che sviluppano con l'AI ogni giorno.
      </p>
      <p>
        Vengo dallo sviluppo web e dalla community WordPress: speaker ai WordCamp, organizer di
        WordCamp Pisa e del Meetup di Pisa.
      </p>
      <p>
        Ogni settimana leggo paper, benchmark e annunci sull'AI. Qui pubblico quello che resta dopo
        il filtro: tesi, prove a favore, prove contro.
      </p>
      <p>
        Il sito è costruito con <a href="https://astro.build">Astro</a> e
        <a href="https://tailwindcss.com">Tailwind CSS</a>, e gira su
        <a href="https://workers.cloudflare.com">Cloudflare Workers</a>.
      </p>
    </div>
  </div>
</BaseLayout>
