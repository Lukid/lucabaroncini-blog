---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NotebookCard from "@/components/NotebookCard.astro";

const temi = [
  {
    href: "/osservatorio/harness-vs-modello",
    title: "Conta più l'harness o il modello?",
    summary: "Conviene pagare il modello più forte o lavorare su come lo usi? Dipende da quanto il compito è difficile per quel modello. Tredici misure per capirlo.",
    updated: "4 novembre 2026",
  },
];
---

<BaseLayout
  title="Osservatorio AI"
  description="Le tesi sull'AI applicata che seguo nel tempo, con le prove a favore, le prove contro e i limiti di ogni misura."
>
  <NotebookCard label="osservatorio.md" class="mt-2">
    <h1 class="font-mono text-[22px] font-semibold leading-tight sm:text-[24px]">
      <span class="text-accent"># </span>Osservatorio AI
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed">
      Ogni settimana leggo paper, benchmark e annunci. Qui tengo le poche tesi che contano, con le
      prove a favore e quelle contro. Le pagine si aggiornano quando arriva una misura nuova.
    </p>
  </NotebookCard>

  <section class="mt-10 space-y-4">
    {temi.map((t) => (
      <a href={t.href} class="group block border border-text bg-surface p-6 transition-colors hover:bg-bg-secondary">
        <h2 class="font-display text-[24px] leading-snug group-hover:text-accent">{t.title}</h2>
        <p class="mt-2 text-text-secondary">{t.summary}</p>
        <p class="mt-3 font-mono text-[11px] uppercase text-text-secondary" style="letter-spacing: 0.15em;">aggiornato al {t.updated} →</p>
      </a>
    ))}
  </section>
</BaseLayout>
