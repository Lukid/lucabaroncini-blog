---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Campo from "@/components/Campo.astro";

const temi = [
  {
    href: "/osservatorio/harness-vs-modello",
    title: "Conta più l'harness o il modello?",
    summary: "Conviene pagare il modello più forte o lavorare su come lo usi? Dipende da quanto il compito è difficile per quel modello. Tredici misure per capirlo.",
    updated: "4 novembre 2026",
  },
];
---

<BaseLayout
  title="Osservatorio AI"
  description="Le tesi sull'AI applicata che seguo nel tempo, con le prove a favore, le prove contro e i limiti di ogni misura."
>
  <Campo slot="campo" fondo="rosso" seme="osservatorio">
    <h1 class="text-5xl leading-none font-black tracking-[-0.035em] sm:text-7xl">Osservatorio AI</h1>
    <p class="mt-6 max-w-[60ch] text-xl leading-snug">
      Ogni settimana leggo paper, benchmark e annunci. Qui tengo le poche tesi che contano, con le
      prove a favore e quelle contro. Le pagine si aggiornano quando arriva una misura nuova.
    </p>
  </Campo>

  <section aria-label="Tesi seguite" class="border-t border-border">
    {temi.map((t) => (
      <article class="group relative border-b border-border py-8">
        <h2 class="max-w-[24ch] text-3xl leading-tight font-black tracking-[-0.025em] text-balance sm:text-4xl">
          <a href={t.href} class="transition-colors group-hover:text-accent after:absolute after:inset-0">{t.title}</a>
        </h2>
        <p class="mt-3 max-w-[60ch] text-text-secondary">{t.summary}</p>
        <p class="mt-4 text-[0.8125rem] font-bold tracking-[0.12em] text-text-secondary uppercase">Aggiornato al {t.updated}</p>
      </article>
    ))}
  </section>
</BaseLayout>
