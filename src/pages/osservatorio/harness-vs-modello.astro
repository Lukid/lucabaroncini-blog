---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NotebookCard from "@/components/NotebookCard.astro";

// Dati: solo punteggi in scala 0-100 (percentuale di task riusciti o punteggio), così l'asse è uno solo.
// Ogni riga: risultato peggiore e migliore fra le configurazioni provate dalla fonte.
type Lever = "harness" | "modello";
interface Row {
  lever: Lever;
  label: string;
  fixed: string;
  from: number;
  to: number;
  task: string;
  caveat: string;
  source: string;
  url: string;
  asOf: string;
}

const rows: Row[] = [
  { lever: "harness", label: "Cambio solo il modo in cui l'agente modifica i file", fixed: "stesso modello: Grok Code Fast", from: 6.7, to: 68.3, task: "modifiche al codice andate a buon fine", caveat: "l'ha misurato l'autore dello strumento e nessuno l'ha ancora rifatto. Su un altro modello lo stesso trucco rende meno.", source: "oh-my-pi", url: "https://github.com/can1357/oh-my-pi", asOf: "agosto 2026" },
  { lever: "harness", label: "Provo dieci agenti di coding diversi", fixed: "stesso modello open: DeepSeek V4 Flash", from: 2.7, to: 54.9, task: "113 task di programmazione risolti", caveat: "una prova sola, fatta da chi vende uno dei dieci agenti.", source: "CodeAF", url: "https://github.com/Agent-Field/CodeAF", asOf: "ottobre 2026" },
  { lever: "harness", label: "Cambio il sistema di memoria, con un modello piccolo", fixed: "stesso modello: GPT-4o-mini", from: 28, to: 63, task: "risposte giuste a domande che richiedono di ricordare cose dette prima", caveat: "una prova per combinazione. I sistemi peggiori spesso falliscono perché non aprono nemmeno il file giusto.", source: "MemoryTax", url: "https://arxiv.org/abs/2610.29823", asOf: "ottobre 2026" },
  { lever: "harness", label: "Lascio che l'agente migliori da solo il proprio harness", fixed: "stesso modello", from: 46.7, to: 76.7, task: "codice che funziona ed è sicuro", caveat: "solo 30 task, un campione piccolo.", source: "Harmony", url: "https://arxiv.org/abs/2610.15150", asOf: "ottobre 2026" },
  { lever: "harness", label: "Do all'agente strumenti e un ritorno sugli errori", fixed: "stesso modello: GLM-5.1", from: 52.5, to: 65.5, task: "bug reali risolti, su 100", caveat: "il numero viene da un report di sintesi, non da uno studio fatto apposta.", source: "State of AI 2026", url: "https://www.stateof.ai/2026-explore/", asOf: "ottobre 2026" },
  { lever: "harness", label: "Divido l'agente in tre ruoli separati", fixed: "stesso modello: Kimi-K3", from: 58.3, to: 72.0, task: "lavori completati al computer, su un desktop vero", caveat: "il confronto con gli altri sistemi non usa le stesse regole né lo stesso budget.", source: "RSIAgent", url: "https://aetherlabsai.github.io/RSIAgent/", asOf: "settembre 2026" },
  { lever: "harness", label: "Faccio riscrivere l'harness a un modello più forte", fixed: "stesso modello esecutore: GLM-5", from: 64.2, to: 75.7, task: "punteggio massimo su compiti di lavoro d'ufficio", caveat: "chi riscrive è più forte di chi esegue, e consuma fra 10 e 100 milioni di token per task. Parte dei voti li dà un altro modello.", source: "Harness²", url: "https://arxiv.org/abs/2610.14224", asOf: "ottobre 2026" },
  { lever: "harness", label: "Cambio il sistema di memoria, con un modello forte", fixed: "stesso modello: Opus 5.5", from: 97, to: 99, task: "risposte giuste a domande che richiedono di ricordare cose dette prima", caveat: "una prova per combinazione. La qualità resta quasi uguale, il costo va da 7 a 28 dollari.", source: "MemoryTax", url: "https://arxiv.org/abs/2610.29823", asOf: "ottobre 2026" },
  { lever: "harness", label: "Provo Claude Code, Codex e Pi", fixed: "stesso modello: Fable 5", from: 96.7, to: 97.8, task: "60 task di programmazione e da terminale risolti", caveat: "le differenze di qualità stanno quasi tutte dentro il margine d'errore. Quelle di costo no.", source: "HarnessTax", url: "https://harnesstax.github.io/", asOf: "ottobre 2026" },
  { lever: "modello", label: "Sei modelli nello stesso harness, compito difficile", fixed: "stesso harness", from: 22.7, to: 86.7, task: "compiti risolti ragionando su documenti lunghissimi", caveat: "i modelli deboli non sbagliano il formato: non riescono a mettere insieme i passaggi.", source: "Scroll", url: "https://arxiv.org/abs/2608.21690", asOf: "agosto 2026" },
  { lever: "modello", label: "Quattro modelli open nella stessa configurazione", fixed: "stesso harness", from: 25.2, to: 65.8, task: "bug reali risolti", caveat: "solo modelli aperti.", source: "Fan et al.", url: "https://arxiv.org/abs/2609.20804", asOf: "ottobre 2026" },
  { lever: "modello", label: "Tengo l'harness e cambio modello", fixed: "stesso harness: CodeAF", from: 54.9, to: 77.9, task: "113 task di programmazione risolti", caveat: "è la stessa fonte della riga da 52 punti: lì cambiava l'harness, qui il modello.", source: "CodeAF", url: "https://github.com/Agent-Field/CodeAF", asOf: "ottobre 2026" },
  { lever: "modello", label: "Sei modelli nello stesso harness, compito facile", fixed: "stesso harness", from: 88.8, to: 94.8, task: "risposte giuste su dettagli di conversazioni lunghe", caveat: "stesse condizioni della riga sui documenti lunghi. Qui il compito è facile e i modelli quasi si equivalgono.", source: "Scroll", url: "https://arxiv.org/abs/2608.21690", asOf: "agosto 2026" },
];

const fmt = (n: number) => n.toLocaleString("it-IT", { maximumFractionDigits: 1 });
const gain = (r: Row) => r.to - r.from;

const title = "Conta più l'harness o il modello?";
const description =
  "Ho messo in fila tredici misure pubbliche. Con un modello al limite l'harness fa la differenza, con un compito facile decide quanto paghi, con un compito troppo difficile serve un modello migliore.";
---

<BaseLayout title={title} description={description}>
  <!-- Generata dalla nota "L'harness e il differenziatore non il modello AI" del vault personale. Dati al 2026-11-04. -->
  <style>
    .dv { --h: #2b6cb0; --m: #c05621; }
    :global(.dark) .dv { --h: #4a8bd6; --m: #c96a2c; }
    .track { position: relative; height: 22px; }
    .track .rule { position: absolute; inset: 50% 0 auto 0; border-top: 1px dashed var(--color-notebook-rule); }
    .track .span { position: absolute; top: calc(50% - 1px); height: 2px; background: var(--c); }
    .track .dot { position: absolute; top: 50%; width: 10px; height: 10px; border-radius: 50%; transform: translate(-50%, -50%); background: var(--c); box-shadow: 0 0 0 2px var(--color-surface); }
    .track .dot.from { background: var(--color-surface); border: 2px solid var(--c); }
    .row[data-lever="harness"] { --c: var(--h); }
    .row[data-lever="modello"] { --c: var(--m); }
    .key { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: middle; }
    .row summary { list-style: none; cursor: pointer; }
    .row summary::-webkit-details-marker { display: none; }
    .row summary:hover .lbl, .row[open] .lbl { color: var(--color-accent); }
    .row summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
    .filters button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }
    .grid-row { display: grid; grid-template-columns: minmax(0, 18rem) minmax(0, 1fr) 4rem; gap: 0.75rem; align-items: center; }
    @media (max-width: 640px) { .grid-row { grid-template-columns: minmax(0, 1fr) 3.5rem; } .grid-row .track { grid-column: 1 / -1; grid-row: 2; } }
  </style>

  <article class="dv">
    <p class="font-mono text-[11px] uppercase text-text-secondary" style="letter-spacing: 0.2em;">
      <a href="/osservatorio" class="hover:text-accent">osservatorio</a> / aggiornato al 4 novembre 2026
    </p>
    <h1 class="mt-3 font-display text-[34px] leading-tight sm:text-[42px]">{title}</h1>

    <p class="mt-5 text-[19px] leading-relaxed">
      Me lo chiedono spesso: conviene pagare il modello più forte o lavorare su come lo usiamo?
      Per un po' ho risposto "conta come lo usi". Poi ho messo in fila le misure, e la risposta
      giusta è un'altra: dipende da quanto il compito è difficile per quel modello.
    </p>
    <p class="mt-4 text-text-secondary">
      Quando dico harness intendo tutto quello che sta intorno al modello: le istruzioni che gli dai,
      gli strumenti che può usare, cosa gli fai leggere, i controlli sul suo lavoro. Il modello è il
      motore, l'harness è il resto della macchina.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <NotebookCard label="modello al limite">
        <p class="font-display text-[22px] leading-snug">L'harness fa la differenza</p>
        <p class="mt-2 text-[15px] text-text-secondary">
          Con un modello piccolo, cambiare solo il modo in cui modifica i file lo porta dal 7% al 68% di modifiche riuscite.
        </p>
      </NotebookCard>
      <NotebookCard label="compito facile">
        <p class="font-display text-[22px] leading-snug">L'harness decide quanto paghi</p>
        <p class="mt-2 text-[15px] text-text-secondary">
          Con un modello di frontiera tre agenti diversi arrivano quasi allo stesso risultato. Uno costa il doppio dell'altro.
        </p>
      </NotebookCard>
      <NotebookCard label="compito troppo difficile">
        <p class="font-display text-[22px] leading-snug">Serve un modello migliore</p>
        <p class="mt-2 text-[15px] text-text-secondary">
          Sui documenti lunghissimi, a parità di harness, fra il modello migliore e il peggiore ci sono 64 punti.
        </p>
      </NotebookCard>
    </div>

    <NotebookCard label="le misure" class="mt-12">
      <h2 class="font-display text-[24px] leading-snug">Le tredici misure</h2>
      <p class="mt-2 text-[15px] text-text-secondary">
        In ogni riga qualcuno ha tenuto ferma una cosa e cambiato l'altra. Il cerchio vuoto è il
        risultato peggiore, quello pieno il migliore. Clicca una riga per sapere cosa si misurava, i
        limiti della prova e la fonte.
      </p>

      <div class="filters mt-5 flex flex-wrap items-center gap-2 font-mono text-[12px]" role="group" aria-label="Filtra le misure">
        <button type="button" data-filter="all" aria-pressed="true" class="border border-text px-2.5 py-1">tutte</button>
        <button type="button" data-filter="harness" aria-pressed="false" class="border border-text px-2.5 py-1">
          <span class="key" style="background: var(--h);"></span> stesso modello, cambio l'harness
        </button>
        <button type="button" data-filter="modello" aria-pressed="false" class="border border-text px-2.5 py-1">
          <span class="key" style="background: var(--m);"></span> stesso harness, cambio il modello
        </button>
      </div>

      <div class="grid-row mt-6 font-mono text-[11px] uppercase text-text-secondary" aria-hidden="true">
        <span class="max-sm:hidden"></span>
        <div class="relative h-4 max-sm:hidden">
          {[0, 25, 50, 75, 100].map((t) => (
            <span class="absolute -translate-x-1/2" style={`left:${t}%`}>{t}</span>
          ))}
        </div>
        <span class="text-right max-sm:col-start-2">punti</span>
      </div>

      <div id="rows" class="mt-1">
        {rows.map((r) => (
          <details class="row border-b border-dashed border-notebook-rule py-2" data-lever={r.lever}>
            <summary class="grid-row text-[15px]">
              <span class="lbl leading-snug">
                {r.label}
                <span class="block font-mono text-[11px] text-text-secondary">{r.fixed}</span>
              </span>
              <span class="track" role="img" aria-label={`da ${fmt(r.from)} a ${fmt(r.to)}`}>
                <span class="rule"></span>
                <span class="span" style={`left:${r.from}%; width:${gain(r)}%`}></span>
                <span class="dot from" style={`left:${r.from}%`}></span>
                <span class="dot" style={`left:${r.to}%`}></span>
              </span>
              <span class="text-right font-mono font-semibold">+{fmt(gain(r))}</span>
            </summary>
            <div class="mt-3 mb-2 space-y-1 border-l-2 pl-4 text-[15px]" style="border-color: var(--c);">
              <p>Da {fmt(r.from)}% a {fmt(r.to)}% di {r.task}.</p>
              <p class="text-text-secondary">Da prendere con le pinze: {r.caveat}</p>
              <p class="font-mono text-[12px]">
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-accent underline">{r.source}</a>
                <span class="text-text-secondary"> · {r.asOf}</span>
              </p>
            </div>
          </details>
        ))}
      </div>
    </NotebookCard>

    <h2 class="mt-14 font-display text-[26px]">Cosa ne ricavo</h2>
    <ul class="mt-4 list-disc space-y-3 pl-5">
      <li>I guadagni enormi cambiando l'harness arrivano tutti con modelli piccoli o open. Con i modelli di frontiera la qualità si avvicina e resta la differenza di costo.</li>
      <li>Non tutto l'harness vale uguale. I pezzi che controllano il lavoro, come far girare i test, spostano il risultato. Aggiungere istruzioni spesso no: i file tipo AGENTS.md valgono più o meno zero e fanno spendere il 20% in più (<a href="https://arxiv.org/abs/2602.11988" target="_blank" rel="noopener noreferrer" class="text-accent underline">studio</a>).</li>
      <li>Un harness costruito su un modello non si porta dietro il guadagno quando cambi modello. A ogni cambio va rimisurato.</li>
      <li>Per questo, prima di aggiungere pezzi, provo a toglierli. Se il risultato regge, ho appena risparmiato.</li>
    </ul>

    <h2 class="mt-14 font-display text-[26px]">Cosa non dice questa pagina</h2>
    <ul class="mt-4 list-disc space-y-3 pl-5 text-text-secondary">
      <li>Le prove usano test diversi. Le righe servono a vedere l'andamento, non a confrontare i numeri fra loro.</li>
      <li>Ogni riga mette a confronto il caso peggiore e il migliore. Più configurazioni provi, più la distanza cresce.</li>
      <li>Molti numeri vengono da chi vende lo strumento o da una prova sola. Riporto i limiti che dichiarano le fonti stesse.</li>
      <li>Cambierei idea se i guadagni dell'harness sparissero anche sui modelli open, o se un harness desse lo stesso guadagno su modelli diversi.</li>
    </ul>
  </article>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll(".filters button");
      var rows = document.querySelectorAll("#rows .row");
      buttons.forEach(function (b) {
        b.addEventListener("click", function () {
          var f = b.dataset.filter;
          buttons.forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
          rows.forEach(function (r) { r.hidden = f !== "all" && r.dataset.lever !== f; });
        });
      });
    })();
  </script>
</BaseLayout>
