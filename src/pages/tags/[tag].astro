---
import { pubblicato, ordinaPerData } from "@/lib/posts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import { getCollection } from "astro:content";
import { TAGS } from "@/lib/constants";
import type { Tag } from "@/lib/constants";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => pubblicato(data));
  return TAGS.map((tag) => ({
    params: { tag },
    props: {
      posts: ordinaPerData(allPosts.filter((post) => post.data.tags.includes(tag))),
    },
  }));
}

const { tag } = Astro.params as { tag: Tag };
const { posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Tutti gli articoli con tag "${tag}".`}>
  <header>
    <h1 class="text-5xl leading-none font-black tracking-[-0.035em] break-words sm:text-7xl">{tag}</h1>
    <p class="mt-4 text-lg text-text-secondary">
      {posts.length} {posts.length === 1 ? "articolo" : "articoli"} con questo tag.
    </p>
  </header>

  {posts.length > 0 ? (
    <div class="mt-10 border-t border-border">
      {posts.map((post: any) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
        />
      ))}
    </div>
  ) : (
    <p class="mt-10 text-lg">Ancora nessun articolo con questo tag.</p>
  )}

  <a href="/blog" class="mt-10 inline-block font-bold underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">
    Tutte le idee
  </a>
</BaseLayout>
