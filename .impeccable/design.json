  "narrative": {
    "northStar": "Il manifesto di numeri",
    "overview": "Ogni idea parte da un numero che diventa manifesto: un campo di colore pieno, una cifra gigantesca costruita da forme geometriche, una frase sotto. Sistema piatto: nessuna ombra, raggio o sfumatura.",
    "keyCharacteristics": [
      "Cinque colori piatti, un campo pieno per schermata.",
      "Archivo variabile, pesi 800-900, cifre tabulari.",
      "La cifra si compone dalle sue forme; statica con movimento ridotto.",
      "Zero ombre, zero raggi, zero gradienti.",
      "Il contrasto decide l'inchiostro, non il gusto."
    ],
    "rules": [
      {
        "name": "The Un-Solo-Campo Rule",
        "body": "Ogni schermata ha un solo colore di fondo, a tutta larghezza.",
        "section": "colors"
      },
      {
        "name": "The Inchiostro Rule",
        "body": "L'inchiostro segue il campo; la cifra e l'accento sono ocra solo dove il contrasto regge.",
        "section": "colors"
      },
      {
        "name": "The Ancora-Misurata Rule",
        "body": "Una forma sta su un glifo solo nei punti di ANCORE; se cambia il font vanno rimisurati.",
        "section": "shapes"
      },
      {
        "name": "The Piatto-Sempre Rule",
        "body": "Nessun box-shadow, text-shadow o gradiente.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do dare a ogni schermata un solo campo pieno.",
      "Do scegliere l'inchiostro dal contrasto.",
      "Do costruire la composizione dallo stesso seme in feed, articolo e copertina.",
      "Do tenere un'unica famiglia, Archivo.",
      "Do dare ai comandi almeno 44px.",
      "Do lasciare statica la composizione con prefers-reduced-motion."
    ],
    "donts": [
      "Don't usare ombre, sfumature o angoli arrotondati.",
      "Don't usare l'ocra per testo o bordi su carta.",
      "Don't mettere una forma su un glifo fuori da ANCORE.",
      "Don't tornare al feed di card su bianco.",
      "Don't aggiungere un secondo carattere di titolo."
    ]
  }
